# Allow installing recently-published packages.
# pnpm 11 enforces a minimum release age by default; our transitive deps
# (electron-to-chromium, node-releases, semver, etc.) are legitimate and
# sometimes newer than that cutoff. Setting to 0 disables the age gate.
minimum-release-age=0

# Don't re-verify deps before running scripts. pnpm 11 fails this pre-run
# check on its ignored-build gate (sharp/unrs-resolver), which blocks
# `pnpm dev`. We don't need those build scripts for the dev server.
verify-deps-before-run=false
